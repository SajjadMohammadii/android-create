write "app/src/main/java/$PKG_PATH/MainActivity.kt" <<'EOF'
package __PACKAGE__

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Scaffold
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.tooling.preview.Preview

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            MaterialTheme {
                Scaffold(modifier = Modifier.fillMaxSize()) { innerPadding ->
                    Greeting(
                        name = "__NAME__",
                        modifier = Modifier.padding(innerPadding),
                    )
                }
            }
        }
    }
}

@Composable
fun Greeting(name: String, modifier: Modifier = Modifier) {
    Box(modifier = modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
        Text(text = "Hello, $name!", style = MaterialTheme.typography.headlineMedium)
    }
}

@Preview(showBackground = true)
@Composable
private fun GreetingPreview() {
    MaterialTheme { Greeting(name = "__NAME__") }
}
EOF

write .gitignore <<'EOF'
.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.jks
*.keystore
key.properties
*.bak
EOF

write_vscode_files "$PROJECT_DIR"

if [[ -n "${SDK_DIR:-}" ]]; then
    echo "sdk.dir=$SDK_DIR" > "$PROJECT_DIR/local.properties"
fi

# Kotlin mode: remove or unmark the kotlin-android plugin lines
for f in build.gradle.kts app/build.gradle.kts gradle/libs.versions.toml; do
    if [[ "$KOTLIN_MODE" == "builtin" ]]; then
        sed -i '/@kotlin-plugin/d' "$PROJECT_DIR/$f"
    else
        sed -i -e 's| // @kotlin-plugin||' -e 's| # @kotlin-plugin||' "$PROJECT_DIR/$f"
    fi
done
[[ "$KOTLIN_MODE" == "builtin" ]] && ok "Using AGP built-in Kotlin (no kotlin-android plugin)"

# Build tools: keep the version your reference project pins, if any
if [[ -n "${REF_BUILD_TOOLS:-}" ]]; then
    sed -i "s|    // @build-tools|    buildToolsVersion = \"$REF_BUILD_TOOLS\"|" "$PROJECT_DIR/app/build.gradle.kts"
    ok "Using build tools $REF_BUILD_TOOLS (same as reference project)"
else
    sed -i '/\/\/ @build-tools/d' "$PROJECT_DIR/app/build.gradle.kts"
fi

# Keep Android Gradle flags that your Android Studio project relies on
if [[ -n "$REF_PROJECT" && -f "$REF_PROJECT/gradle.properties" ]]; then
    grep -E '^[[:space:]]*android\.(builtInKotlin|newDsl)[[:space:]]*=' "$REF_PROJECT/gradle.properties" \
        >> "$PROJECT_DIR/gradle.properties" || true
fi

ok "Project files written"

# --- Gradle wrapper ---------------------------------------------------------
step "Setting up Gradle wrapper ($GRADLE_VERSION)"

copy_wrapper_from() {  # copy_wrapper_from <dir containing gradlew + gradle/wrapper>
    cp "$1/gradlew" "$PROJECT_DIR/"
    [[ -f "$1/gradlew.bat" ]] && cp "$1/gradlew.bat" "$PROJECT_DIR/"
    mkdir -p "$PROJECT_DIR/gradle/wrapper"
    cp "$1/gradle/wrapper/gradle-wrapper.jar" "$1/gradle/wrapper/gradle-wrapper.properties" \
        "$PROJECT_DIR/gradle/wrapper/"
    chmod +x "$PROJECT_DIR/gradlew"
}

if [[ -n "$REF_PROJECT" ]]; then
    # Same wrapper + same distribution URL as Android Studio -> uses the already cached Gradle
    copy_wrapper_from "$REF_PROJECT"
    ok "gradlew copied from $REF_PROJECT"
else
    find_gradle() {
        local dists="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists"
        if [[ -d "$dists" ]]; then
            find "$dists" -path '*/bin/gradle' -type f 2>/dev/null | sort -rV | head -n 1
        fi
        command -v gradle 2>/dev/null || true
    }
    GRADLE_BIN="$(find_gradle | head -n 1)"
    [[ -n "$GRADLE_BIN" ]] || die "No Gradle found. Create and sync one project in Android Studio first, then run android-create again."
    chmod +x "$GRADLE_BIN" 2>/dev/null || true
    ok "Using Gradle: $GRADLE_BIN"

    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_DIR"' EXIT
    mkdir -p "$TMP_DIR/w"
    echo 'rootProject.name = "wrapper"' > "$TMP_DIR/w/settings.gradle.kts"
    # --no-validate-url: do not contact services.gradle.org while generating the wrapper
    if ! ( cd "$TMP_DIR/w" && "$GRADLE_BIN" wrapper --gradle-version "$GRADLE_VERSION" \
              --distribution-type bin --no-validate-url --quiet --offline ) 2>/dev/null; then
        ( cd "$TMP_DIR/w" && "$GRADLE_BIN" wrapper --gradle-version "$GRADLE_VERSION" \
              --distribution-type bin --quiet --offline ) || die "gradle wrapper failed"
    fi
    copy_wrapper_from "$TMP_DIR/w"
    ok "gradlew ready"
    warn "The first ./gradlew run downloads Gradle $GRADLE_VERSION from services.gradle.org."
fi

# --- Done -------------------------------------------------------------------
echo
echo "${c_ok}Project created: $PROJECT_DIR${c_off}"
echo
echo "Run it on your phone:"
echo "  VS Code:   press F5 (Run on Android)"
echo "  Terminal:  cd $NAME && ./run-android.sh          (add --watch to reload on every save)"
echo

if (( OPEN )); then
    if command -v code >/dev/null 2>&1; then
        code "$PROJECT_DIR"
    else
        warn "'code' command not found. Install VS Code (e.g. sudo snap install code --classic)."
    fi
fi
